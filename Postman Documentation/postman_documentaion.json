{
  "info": {
    "name": "CBT Exam Platform API",
    "description": "Multi-tenant exam platform API for creating exams, managing candidates, and auto-grading submissions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000/api/v1", "type": "string" },
    { "key": "token", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Tenants",
      "item": [
        {
          "name": "Create a new tenant",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acme School\",\n  \"email\": \"admin@acme.com\",\n  \"plan\": \"pro\"\n}"
            },
            "url": { "raw": "{{base_url}}/tenants", "host": ["{{base_url}}"], "path": ["tenants"] }
          }
        },
        {
          "name": "Delete tenant",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{base_url}}/tenants/:id", "host": ["{{base_url}}"], "path": ["tenants", ":id"], "variable": [{ "key": "id", "value": "tenant_id_here" }] }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Admin login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if(json.token){ pm.collectionVariables.set(\"token\", json.token); }"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Groups",
      "item": [
        {
          "name": "Create candidate group",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Batch 2026\",\n  \"description\": \"Final year students\"\n}"
            },
            "url": { "raw": "{{base_url}}/candidate-groups", "host": ["{{base_url}}"], "path": ["candidate-groups"] }
          }
        }
      ]
    },
    {
      "name": "Exams",
      "item": [
        {
          "name": "Create exam",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Math Final\",\n  \"subject\": \"Mathematics\",\n  \"duration\": 120,\n  \"passMark\": 50,\n  \"questions\": [\n    {\n      \"type\": \"mcq\",\n      \"question\": \"2+2=?\",\n      \"options\": [\"3\", \"4\", \"5\"],\n      \"answer\": \"4\",\n      \"marks\": 5\n    }\n  ]\n}"
            },
            "url": { "raw": "{{base_url}}/exams", "host": ["{{base_url}}"], "path": ["exams"] }
          }
        },
        {
          "name": "Submit exam answers",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": [\"4\", \"true\", \"Paris\"]\n}"
            },
            "url": { "raw": "{{base_url}}/exams/:id/submit", "host": ["{{base_url}}"], "path": ["exams", ":id", "submit"], "variable": [{ "key": "id", "value": "exam_id_here" }] }
          }
        }
      ]
    },
    {
      "name": "Candidates",
      "item": [
        {
          "name": "Create candidate",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"pass123\",\n  \"groupId\": \"group_id_here\"\n}"
            },
            "url": { "raw": "{{base_url}}/candidates", "host": ["{{base_url}}"], "path": ["candidates"] }
          }
        },
        {
          "name": "Candidate login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"pass123\"\n}"
            },
            "url": { "raw": "{{base_url}}/candidates/login", "host": ["{{base_url}}"], "path": ["candidates", "login"] }
          }
        }
      ]
    },
    {
      "name": "Scoring",
      "item": [
        {
          "name": "Get scoring result",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/scoring/session/:sessionId", "host": ["{{base_url}}"], "path": ["scoring", "session", ":sessionId"], "variable": [{ "key": "sessionId", "value": "session_id_here" }] }
          }
        }
      ]
    }
  ]
}