# ─────────────────────────────────────────────────────────────────
#  .env.example — Group 7 Capstone: Multitenancy CBT Platform
#  Copy this file as .env and fill in your real values.
#  ⚠️  NEVER commit your real .env file to GitHub.
# ─────────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/cbt_platform

# JWT Configuration (used by F1 - Auth feature)
JWT_SECRET=your_super_secret_key_here_change_this
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_here_change_this
JWT_REFRESH_EXPIRES_IN=30d

# Password Hashing (used by F1 - Auth feature)
BCRYPT_ROUNDS=12

# Email / SMTP (used by F10 - Notifications feature)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass

# Frontend URL (used for CORS and email links)
FRONTEND_URL=http://localhost:3000

# Super Admin Seed (used for initial Super Admin creation)
SUPER_ADMIN_EMAIL=admin@cbtplatform.com
SUPER_ADMIN_PASSWORD=ChangeMeImmediately123!